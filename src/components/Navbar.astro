---
import { Image } from 'astro:assets';
import logo from '../../public/logo.png';

const defaultStyles = 'text-lg align-middle transition-colors hover:text-gold-500'
const disabledStyles = 'text-lg align-middle opacity-50 cursor-not-allowed'

const navLinks = [
	{ label: 'Home', href: '', disabled: false },
	{ label: 'About', href: 'about', disabled: false },
	{ label: 'Conference', href: 'conference', disabled: false },
	{ label: 'Committees', href: 'committees', disabled: false },
	{ label: "Preparation", href: '#preparation', disabled: true },
	{ label: 'Apply', href: 'apply', disabled: false },
	{ label: 'Sponsors & Affiliates', href: '#sponsors', disabled: true },
	{ label: 'Registration', href: '#registration', disabled: true },
];

// Astro.url.pathname lets you detect the current page for "active link" styling
const currentPath = Astro.url.pathname;
---
<div class="sticky top-0 flex items-center bg-lavender-500 text-light-500 text-md font-bold px-4 py-4 z-99 h-12" role="alert">
	<svg class="fill-current w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M12.432 0c1.34 0 2.01.912 2.01 1.957 0 1.305-1.164 2.512-2.679 2.512-1.269 0-2.009-.75-1.974-1.99C9.789 1.436 10.67 0 12.432 0zM8.309 20c-1.058 0-1.833-.652-1.093-3.524l1.214-5.092c.211-.814.246-1.141 0-1.141-.317 0-1.689.562-2.502 1.117l-.528-.88c2.572-2.186 5.531-3.467 6.801-3.467 1.057 0 1.233 1.273.705 3.23l-1.391 5.352c-.246.945-.141 1.271.106 1.271.317 0 1.357-.392 2.379-1.207l.6.814C12.098 19.02 9.365 20 8.309 20z"/></svg>
	<a href="/apply" class="px-2 hover:text-white transition-all hover:scale-101 hover:underline">Staff applications are open until October 1st.</a>
</div>

<header class="sticky top-12 z-50 bg-light-500 shadow-lg font-headings h-30">
	<div class="max-w-6xl px-4 flex justify-between h-full">

		<a href={import.meta.env.BASE_URL}>
			<Image src={logo} alt="DCBMUN Logo" loading="eager" fetchpriority="high" class="size-30 sticky top-0 left-2"/>
		</a>

		<!-- Desktop links: hidden on mobile, shown from md breakpoint up -->
		<ul class="hidden md:flex items-center self-center gap-8">
			{navLinks.map(link => {
				const href = link.disabled ? null : `${import.meta.env.BASE_URL}${link.href}`;
				const isActive = currentPath === href || currentPath === href + '/';
				return (
					<li>
						<a
							href={href}
							class={`${
								link.disabled ? disabledStyles : defaultStyles
							} ${
								isActive ? 'font-bold' : 'font-medium'
							}`}
						>
							{link.label}
						</a>
					</li>
				);
			})}
		</ul>

		<!-- Hamburger menu button: hidden on desktop -->
		<button id="mobile-menu-button" class="md:hidden self-center p-2 text-2xl leading-none" aria-label="Toggle menu" aria-expanded="false">
			<span id="mobile-menu-icon">☰</span>
		</button>

		<!-- Hamburger menu: hidden until toggled, hidden entirely on desktop -->
		<ul id="mobile-menu" class="flex flex-col items-center gap-6 py-6 absolute top-full left-0 w-full bg-light-500 shadow-lg md:hidden opacity-0 -translate-y-2 pointer-events-none invisible transition-all duration-200 ease-out">
			{navLinks.map(link => {
				const href = link.disabled ? null : `${import.meta.env.BASE_URL}${link.href}`;
				const isActive = currentPath === href || currentPath === href + '/';
				return (
					<li>
						<a href={href} data-disabled={link.disabled} class={`${link.disabled ? disabledStyles : defaultStyles} ${isActive ? 'font-bold' : 'font-medium'}`}>
							{link.label}
						</a>
					</li>
				)
			})}
		</ul>
	</div>
</header>

<script>
	const button = document.getElementById('mobile-menu-button');
	const menu = document.getElementById('mobile-menu');
	const icon = document.getElementById('mobile-menu-icon');

	function setMenuOpen(open) {
		menu?.classList.toggle('opacity-0', !open);
		menu?.classList.toggle('-translate-y-2', !open);
		menu?.classList.toggle('pointer-events-none', !open)
		menu?.classList.toggle('invisible', !open);
		button.setAttribute('aria-expanded', String(open));
		if (icon) icon.textContent = open? '✕' : '☰';
	}

	let isOpen = false;

	button?.addEventListener('click', () => {
		isOpen = !isOpen;
		setMenuOpen(isOpen);
	});

	menu.querySelectorAll('a').forEach(link => {
		link.addEventListener('click', (e) => {
			if (link.dataset.disabled === 'true') {
				e.preventDefault();
				return;
			}
			isOpen = false;
			setMenuOpen(false);
		});
	});
</script>
